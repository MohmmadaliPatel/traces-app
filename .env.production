# --- DSC (digital signature) for Form 16A / Form 131 certificates ---------
# Windows certificate store subject that signs the PDFs. This one value turns
# signing on for every company; Company.dscCertificateName overrides it per company.
# List the certificates on the machine with: yarn dsc:test --no-sign
DSC_CERTIFICATE_NAME=
# Seconds allowed for the signer when the token is cold (a human must type the PIN).
# DSC_PIN_TIMEOUT_SEC=300
# Seconds allowed when the token is already unlocked for this Windows session.
# DSC_SIGN_TIMEOUT_SEC=120
# Extra milliseconds allowed per PDF in a batch, on top of the timeouts above.
# DSC_PER_PDF_MS=1500
# Set to 1 to generate PDFs without signing them (sign later with: yarn dsc:sign).
# DSC_SKIP_SIGNING=0
# Minutes the app keeps the token PIN in memory after an unlock, so every company in a
# run signs without a dialog. Memory only - never written to disk. Default 720 (12h).
# DSC_PIN_TTL_MIN=720
# Set to 0 to run one signer process per batch instead of keeping one alive. Keeping one
# alive is what stops the token asking for a PIN once per company.
# DSC_SIGNER_DAEMON=1
